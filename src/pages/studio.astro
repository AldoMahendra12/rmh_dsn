    <!-- GSAP / Scripts -->
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      document.addEventListener("astro:page-load", () => {
        // Kill existing triggers to prevent duplicates during client-side navigation
        ScrollTrigger.getAll().forEach(t => t.kill());

        gsap.registerPlugin(ScrollTrigger);





        // --- Fullscreen Menu Overlay ---
        const menuTrigger = document.querySelector('#menu-trigger');
        const menuClose = document.querySelector('#menu-close');
        const menuOverlay = document.querySelector('#menu-overlay');
        const menuTextReveals = document.querySelectorAll('.menu-text-reveal');

        if (menuTrigger && menuOverlay && menuClose) {
          let menuOpen = false;
          const menuTl = gsap.timeline({ paused: true });

          menuTl.to(menuOverlay, {
            clipPath: 'inset(0 0 0% 0)',
            duration: 0.8,
            ease: 'power4.inOut',
          });

          menuTl.to(menuTextReveals, {
            y: '0%',
            duration: 0.6,
            ease: 'power4.out',
            stagger: 0.04,
          }, '-=0.3');

          menuTrigger.addEventListener('click', (e) => {
            e.preventDefault();
            if (!menuOpen) {
              menuOpen = true;
              document.body.style.overflow = 'hidden';
              menuTl.play();
            }
          });

          const closeMenu = () => {
            menuOpen = false;
            document.body.style.overflow = '';
            gsap.to(menuTextReveals, {
              y: '110%',
              duration: 0.4,
              ease: 'power3.in',
              stagger: 0.02,
              onComplete: () => {
                gsap.to(menuOverlay, {
                  clipPath: 'inset(0 0 100% 0)',
                  duration: 0.6,
                  ease: 'power4.inOut',
                  onComplete: () => {
                    menuTl.pause(0);
                  }
                });
              }
            });
          };

          menuClose.addEventListener('click', closeMenu);

          const menuLinks = menuOverlay.querySelectorAll('nav a');
          menuLinks.forEach(link => {
            link.addEventListener('click', closeMenu);
          });
        }

        // --- Contact Drawer Logic ---
        const contactPanel = document.getElementById('contact-panel');
        const contactBackdrop = document.getElementById('contact-backdrop');
        const contactTriggers = document.querySelectorAll('.ngobrol-trigger');
        const contactCloseBtns = document.querySelectorAll('.contact-close');
        const contactNextBtn = document.getElementById('contact-next');
        const contactBackBtn = document.getElementById('contact-back');
        const contactNext2Btn = document.getElementById('contact-next-2');
        const contactBack3Btn = document.getElementById('contact-back-3');
        const contactSubmitBtn = document.getElementById('contact-submit');
        const contactDoneBtn = document.getElementById('contact-done');

        const step1 = document.getElementById('contact-step-1');
        const step2 = document.getElementById('contact-step-2');
        const step3 = document.getElementById('contact-step-3');
        const successScreen = document.getElementById('contact-success');

        let isContactOpen = false;

        const openContact = (e) => {
          if (e) e.preventDefault();
          isContactOpen = true;
          document.body.style.overflow = 'hidden';

          if (step1 && step2 && step3 && successScreen) {
            step1.classList.remove('hidden');
            step2.classList.add('hidden');
            step3.classList.add('hidden');
            successScreen.classList.add('hidden');
          }

          const nameInput = document.getElementById('contact-name') as HTMLInputElement;
          const emailInput = document.getElementById('contact-email') as HTMLInputElement;
          const phoneInput = document.getElementById('contact-phone') as HTMLInputElement;
          const otherDetailsInput = document.getElementById('contact-other-details') as HTMLInputElement;
          if (nameInput) nameInput.value = '';
          if (emailInput) emailInput.value = '';
          if (phoneInput) phoneInput.value = '';
          if (otherDetailsInput) otherDetailsInput.value = '';

          const typeBtns = document.querySelectorAll('.project-type-btn');
          typeBtns.forEach(btn => {
            if (btn.getAttribute('data-value') === 'new-home') {
              btn.classList.add('bg-white', 'text-black');
              btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            } else {
              btn.classList.remove('bg-white', 'text-black');
              btn.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            }
          });

          const hearBtns = document.querySelectorAll('.hear-about-btn');
          hearBtns.forEach(btn => {
            if (btn.getAttribute('data-value') === 'instagram') {
              btn.classList.add('bg-white', 'text-black');
              btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            } else {
              btn.classList.remove('bg-white', 'text-black');
              btn.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            }
          });

          if (contactBackdrop) {
            contactBackdrop.classList.remove('hidden');
            gsap.to(contactBackdrop, { opacity: 1, duration: 0.5 });
          }

          if (contactPanel) {
            gsap.to(contactPanel, {
              clipPath: 'inset(0 0 0 0%)',
              duration: 0.8,
              ease: 'power4.inOut'
            });
          }
        };

        const closeContact = () => {
          isContactOpen = false;
          document.body.style.overflow = '';

          if (contactBackdrop) {
            gsap.to(contactBackdrop, {
              opacity: 0,
              duration: 0.5,
              onComplete: () => {
                contactBackdrop.classList.add('hidden');
              }
            });
          }

          if (contactPanel) {
            gsap.to(contactPanel, {
              clipPath: 'inset(0 0 0 100%)',
              duration: 0.6,
              ease: 'power4.inOut'
            });
          }
        };

        contactTriggers.forEach(btn => btn.addEventListener('click', openContact));
        contactCloseBtns.forEach(btn => btn.addEventListener('click', closeContact));
        contactBackdrop?.addEventListener('click', closeContact);

        // Toggle project type selection (multiple select enabled)
        const projectTypeBtns = document.querySelectorAll('.project-type-btn');
        projectTypeBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            if (btn.classList.contains('bg-white')) {
              btn.classList.remove('bg-white', 'text-black');
              btn.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            } else {
              btn.classList.add('bg-white', 'text-black');
              btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            }
          });
        });

        // Toggle hear about selection (single select)
        const hearAboutBtns = document.querySelectorAll('.hear-about-btn');
        hearAboutBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            hearAboutBtns.forEach(b => {
              b.classList.remove('bg-white', 'text-black');
              b.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            });
            btn.classList.add('bg-white', 'text-black');
            btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
          });
        });

        contactNextBtn?.addEventListener('click', () => {
          const nameInput = document.getElementById('contact-name') as HTMLInputElement;
          const emailInput = document.getElementById('contact-email') as HTMLInputElement;
          if (nameInput && emailInput) {
            if (!nameInput.value.trim() || !emailInput.value.trim()) {
              alert('Harap isi Nama dan Alamat Email Anda.');
              return;
            }
          }
          if (step1 && step2) {
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
          }
        });

        contactBackBtn?.addEventListener('click', () => {
          if (step1 && step2) {
            step2.classList.add('hidden');
            step1.classList.remove('hidden');
          }
        });

        contactNext2Btn?.addEventListener('click', () => {
          const selectedBtns = document.querySelectorAll('.project-type-btn.bg-white');
          if (selectedBtns.length === 0) {
            alert('Harap pilih minimal satu jenis proyek.');
            return;
          }
          if (step2 && step3) {
            step2.classList.add('hidden');
            step3.classList.remove('hidden');
          }
        });

        contactBack3Btn?.addEventListener('click', () => {
          if (step2 && step3) {
            step3.classList.add('hidden');
            step2.classList.remove('hidden');
          }
        });

        contactSubmitBtn?.addEventListener('click', () => {
          const selectedBtns = document.querySelectorAll('.hear-about-btn.bg-white');
          if (selectedBtns.length === 0) {
            alert('Harap pilih salah satu opsi bagaimana Anda mengetahui tentang kami.');
            return;
          }
          const otherBtn = document.querySelector('.hear-about-btn[data-value="other"]');
          if (otherBtn && otherBtn.classList.contains('bg-white')) {
            const otherDetails = document.getElementById('contact-other-details') as HTMLInputElement;
            if (otherDetails && !otherDetails.value.trim()) {
              alert('Harap isi detail bagaimana Anda mengetahui tentang kami.');
              return;
            }
          }
          if (step3 && successScreen) {
            step3.classList.add('hidden');
            successScreen.classList.remove('hidden');
          }
        });

        contactDoneBtn?.addEventListener('click', closeContact);

        // Refresh triggers on next frame to ensure correct height and layout calculations
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
        });
      });
    </script>

  </body>
</html>
