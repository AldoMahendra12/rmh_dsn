---
import { ClientRouter } from "astro:transitions";
import '@fontsource-variable/montserrat';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link class="icon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Studio - Rumah Disain</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen m-0 antialiased tracking-tight relative bg-[#faf9f6] text-black overflow-x-hidden">
    
    <!-- Absolute Header (Stuck at the top, does not scroll down) -->
    <header id="main-header" class="absolute top-0 left-0 w-full flex items-center justify-between px-6 md:px-12 py-6 z-50 bg-transparent text-black border-b border-transparent">
      <div class="overflow-hidden">
        <a href="/" class="group flex items-center cursor-pointer h-12 md:h-16">
          <!-- Logo Icon -->
          <img src="/logo-hitam.png" alt="Rumah Disain Logo" class="h-12 md:h-16 w-auto object-contain transition-transform duration-500 ease-out group-hover:scale-105" />
          
          <!-- Logo Kata Expand & Slide -->
          <div class="flex items-center overflow-hidden max-w-0 opacity-0 invisible transition-all duration-700 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:max-w-[800px] group-hover:opacity-100 group-hover:visible group-hover:-ml-2">
            <img src="/logo-kata.png" alt="Rumah Disain Text" class="h-16 md:h-[8.5rem] w-auto shrink-0 -translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:-translate-x-2 brightness-0" />
          </div>
        </a>
      </div>
      
      <!-- Menu Navigasi (Sliding hover, active STUDIO) -->
      <ul id="header-nav" class="hidden md:flex items-center gap-3 text-sm font-bold tracking-tight text-black transition-colors duration-300">
        <li>
          <div class="overflow-hidden">
            <a href="/karya" class="group/nav relative block h-5 overflow-hidden text-black">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/nav:-translate-y-5">
                <span class="h-5 leading-5 flex items-center">KARYA</span>
                <span class="h-5 leading-5 flex items-center">KARYA</span>
              </div>
            </a>
          </div>
        </li>
        <li class="text-zinc-400">&bull;</li>
        <li>
          <div class="overflow-hidden">
            <a href="/studio" class="group/nav relative block h-5 overflow-hidden text-black font-extrabold border-b-2 border-black pb-0.5">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/nav:-translate-y-5">
                <span class="h-5 leading-5 flex items-center">STUDIO</span>
                <span class="h-5 leading-5 flex items-center">STUDIO</span>
              </div>
            </a>
          </div>
        </li>
        <li class="text-zinc-400">&bull;</li>
        <li>
          <div class="overflow-hidden">
            <a href="/proses" class="group/nav relative block h-5 overflow-hidden text-black">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/nav:-translate-y-5">
                <span class="text-sm font-bold h-5 leading-5 flex items-center">PROSES</span>
                <span class="text-sm font-bold h-5 leading-5 flex items-center">PROSES</span>
              </div>
            </a>
          </div>
        </li>

      </ul>
      
      <div class="flex items-center gap-4">
        <!-- NGOBROL YUK Button -->
        <a href="#" class="ngobrol-trigger group flex items-center gap-4 bg-black text-white px-7 py-3 rounded-full transition-all duration-300 hover:scale-105" id="header-cta-btn">
          <div class="relative h-5 overflow-hidden">
            <div class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-5">
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase text-white">NGOBROL YUK</span>
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase text-white">NGOBROL YUK</span>
            </div>
          </div>
          <span class="relative flex items-center justify-center w-3 h-3">
            <span class="absolute w-3 h-3 rounded-full border border-white bg-white transition-all duration-300 group-hover:scale-50 group-hover:bg-white group-hover:border-transparent" id="header-cta-circle"></span>
          </span>
        </a>
        
        <!-- MENU Button -->
        <a href="#" id="menu-trigger" class="group flex items-center gap-3 bg-black text-white px-7 py-3 rounded-full hover:scale-105 transition-all duration-300 border border-transparent">
          <div class="relative h-5 overflow-hidden">
            <div class="flex flex-col transition-transform duration-300 group-hover:-translate-y-5">
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase text-white">MENU</span>
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase text-white">MENU</span>
            </div>
          </div>
        </a>
      </div>
    </header>

    <!-- Slide 1: Hero Section -->
    <section id="studio-hero" class="h-screen w-full flex items-stretch overflow-hidden relative">
      <!-- Left side border column -->
      <div class="hidden md:flex w-20 lg:w-24 bg-white flex-col items-center justify-center border-r border-zinc-200/40 select-none shrink-0">
        <span class="uppercase text-[10px] font-bold tracking-[0.25em] text-zinc-400 rotate-270 whitespace-nowrap">(ABOUT OUR STUDIO)</span>
      </div>

      <!-- Center main image column -->
      <div class="flex-1 relative overflow-hidden bg-zinc-100 flex items-center justify-center p-0">
        <img src="/office.jpeg" alt="Studio Facade" class="w-full h-full object-cover" />
      </div>

      <!-- Right side border column -->
      <div class="hidden md:flex w-20 lg:w-24 bg-white flex-col items-center justify-center border-l border-zinc-200/40 select-none shrink-0">
        <span class="uppercase text-[10px] font-bold tracking-[0.25em] text-zinc-400 rotate-90 whitespace-nowrap">(SCROLL TO EXPLORE)</span>
      </div>
    </section>

    <!-- Slide 2: Collaborative Text Section -->
    <section id="studio-collaborative" class="w-full bg-white min-h-[90vh] py-28 md:py-36 px-6 md:px-12 flex justify-center items-center">
      <div class="max-w-[90%] md:max-w-5xl text-center">
        <p class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tighter text-zinc-900 text-balance text-center" style="font-size: clamp(2rem, 3.8vw, 4.4rem); line-height: 1.05;">
          Di Rumah Disain, kami menerapkan<br class="hidden md:!inline" />
          pendekatan kolaboratif. Baik saat bekerja<br class="hidden md:!inline" />
          di dalam studio maupun berdampingan<br class="hidden md:!inline" />
          dengan klien dan mitra kami, proses<br class="hidden md:!inline" />
          bersama inilah yang membantu kami<br class="hidden md:!inline" />
          menciptakan karya yang merefleksikan<br class="hidden md:!inline" />
          visi Anda sekaligus visi kami.
        </p>
      </div>
    </section>

    <!-- Slide 3: Split Media Gallery Section -->
    <section id="studio-gallery" class="w-full bg-white px-6 md:px-12 pb-24 md:pb-36 flex flex-col md:flex-row gap-8 items-start justify-between">
      <!-- Left Portrait Column (24%) -->
      <div class="w-full md:w-[24%] aspect-[3/4] overflow-hidden bg-zinc-100 shadow-md rounded-[2px]">
        <img src="/studio1.jpeg" alt="Interior Detail" class="w-full h-full object-cover hover:scale-102 transition-transform duration-700 ease-out" />
      </div>
      <!-- Right Landscape Column (72%) -->
      <div class="w-full md:w-[72%] aspect-[16/10] overflow-hidden bg-zinc-100 shadow-md rounded-[2px]">
        <img src="/studio2.jpeg" alt="Studio Office Life" class="w-full h-full object-cover hover:scale-102 transition-transform duration-700 ease-out" />
      </div>
    </section>

    <!-- Slide 4: Design Ethos Section -->
    <section id="studio-ethos" class="w-full bg-white py-28 md:py-36 px-6 md:px-12 border-t border-zinc-200/30 flex flex-col lg:flex-row gap-4 items-start">
      <!-- Left spacer (32%) -->
      <div class="hidden lg:block lg:w-[32%] shrink-0"></div>

      <!-- Content column (68%) -->
      <div class="w-full lg:w-[68%]">
        <p class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-[-0.06em] text-zinc-900 text-pretty" style="font-size: clamp(2rem, 3.8vw, 4.4rem); line-height: 1.15;">
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] text-zinc-400 uppercase mr-6 md:mr-10 lg:mr-14 translate-y-[-0.2em] select-none">(ETOS DESAIN)</span>Etos desain kami berakar
          <br class="hidden lg:inline" />
          pada prinsip desain pasif, perencanaan matang, dan alur spasial intuitif. Kami mendekati setiap proyek untuk mengurai kompleksitas kehidupan sehari-hari, menghadirkan kemudahan dan kejelasan melalui arsitektur fungsional dan elegan.
        </p>
      </div>
    </section>

    <!-- Slide 5: Interactive Team Section -->
    <section id="studio-team" class="w-full bg-white py-24 md:py-36 px-6 md:px-12 border-t border-zinc-200/50 flex flex-col md:flex-row gap-8 md:gap-12 items-start justify-between">
      <div class="w-full md:w-[15%] select-none">
        <span class="text-[11px] font-bold tracking-[0.2em] text-zinc-400 uppercase">(TIM KAMI)</span>
      </div>
      
      <div class="w-full md:w-[82%] flex flex-col md:flex-row justify-between gap-12 md:gap-16 items-start">
        
        <!-- Left Column: Biography & Details -->
        <div class="w-full md:w-[55%] flex flex-col pt-2">
          <h2 class="text-xs font-bold tracking-widest uppercase text-zinc-400 mb-8 select-none">
            TIM DI BALIK DESAIN KAMI
          </h2>
          
          <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-zinc-900 uppercase mb-2">
            Dimas Arief Hidayat
          </h3>
          <span class="text-sm font-bold uppercase tracking-wider text-zinc-500 mb-8 block">
            Owner & Principal Architect
          </span>

          <div class="w-full h-[1px] bg-zinc-200/60 mb-8"></div>
          
          <p class="text-[0.95rem] md:text-[1.05rem] leading-[1.65] text-zinc-700 font-medium mb-6 text-pretty">
            Dimas Arief Hidayat adalah sosok di balik Rumah Disain. Bergerak sebagai perancang tunggal (one man show), ia memandu setiap proses perancangan secara personal — mulai dari sketsa konsep awal, pengembangan desain, hingga detail dokumentasi konstruksi.
          </p>
          <p class="text-[0.95rem] md:text-[1.05rem] leading-[1.65] text-zinc-700 font-medium text-pretty">
            Dedikasinya terhadap arsitektur yang fungsional, elegan, dan presisi memastikan bahwa setiap proyek dikerjakan dengan standar keahlian tertinggi. Dengan pendekatan langsung ini, setiap visi klien dapat diwujudkan tanpa ada informasi yang terputus di tengah jalan.
          </p>
        </div>

        <!-- Right Column: Large Photo -->
        <div class="w-full md:w-[40%] md:max-w-[360px] flex flex-col gap-6 md:sticky md:top-28 shrink-0">
          <div class="relative w-full aspect-[3/4] overflow-hidden rounded-[2px] shadow-lg bg-zinc-100">
            <img src="/nick_tan.png" alt="Dimas Arief Hidayat" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col gap-1.5">
            <p class="text-xs md:text-sm text-zinc-500 font-semibold tracking-wide uppercase leading-relaxed text-pretty">
              B. ARCH (RMIT), M. ARCH (RMIT)<br>IAI MEMBER NO. 12907<br>OWNER & PRINCIPAL ARCHITECT
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Bold CTA Section (tagline matches homepage exactly) -->
    <section id="studio-cta" class="relative z-10 w-full bg-white text-black overflow-hidden">
      <div class="flex flex-col items-center justify-center text-center px-6 md:px-10 pt-20 md:pt-28 pb-24 md:pb-32 gap-10 md:gap-12">
        <!-- Big Headline identical to homepage tagline -->
        <h2 class="cta-headline text-[12.5vw] md:text-[10.5vw] lg:text-[8.5vw] font-semibold leading-[0.82] tracking-[-0.07em] uppercase text-black max-w-[95vw] w-full flex flex-col gap-1 md:gap-1.5">
          <span class="block text-left pl-0">MERANGKAI RUANG</span>
          <span class="block text-right pr-0">PENUH CERITA</span>
        </h2>

        <!-- CTA Button -->
        <a href="#" class="ngobrol-trigger group inline-flex items-center gap-4 bg-black text-white px-8 py-4 rounded-full hover:scale-105 transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]">
          <div class="relative h-5 overflow-hidden">
            <div class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-5">
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-widest uppercase">CERITAKAN RUMAH IMPIAN ANDA</span>
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-widest uppercase">CERITAKAN RUMAH IMPIAN ANDA</span>
            </div>
          </div>
          <span class="relative flex items-center justify-center w-3 h-3">
            <span class="absolute w-3 h-3 rounded-full border-[1.5px] border-white transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:scale-50 group-hover:bg-white group-hover:border-transparent"></span>
          </span>
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer id="footer" class="relative z-10 w-full bg-white text-black border-t border-black/10">

      <!-- Main Footer Grid — full screen height -->
      <div class="w-full flex flex-col md:flex-row" style="min-height: 100vh;">

        <!-- LEFT: Photo (aspect 3:4) -->
        <div class="w-full md:w-[32%] flex flex-col border-r border-black/10 overflow-hidden bg-white p-6 md:p-8 justify-center items-center" style="min-height:100vh;">
          <div class="w-full aspect-[3/4] overflow-hidden">
            <img src="/au-3.png" alt="Rumah Disain" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out" />
          </div>
        </div>

        <!-- MIDDLE: Navigation — natural stack, large text -->
        <div class="w-full md:w-[36%] flex flex-col border-r border-black/10 px-6 md:px-10 pt-8 md:pt-10 pb-10">
          <p class="text-[14px] font-bold tracking-wide uppercase text-black mb-6">(NAVIGASI)</p>
          <nav class="flex flex-col gap-[0.4em]">
            <a href="/"            class="footer-nav-link group block overflow-hidden" style="height:1em; font-size: clamp(1.6rem, 3.2vw, 3rem); font-weight:700; line-height:1; letter-spacing:-0.05em;">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-[50%]">
                <span class="block">Beranda</span><span class="block">Beranda</span>
              </div>
            </a>
            <a href="/karya"       class="footer-nav-link group block overflow-hidden" style="height:1em; font-size: clamp(1.6rem, 3.2vw, 3rem); font-weight:700; line-height:1; letter-spacing:-0.05em;">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-[50%]">
                <span class="block">Karya</span><span class="block">Karya</span>
              </div>
            </a>
            <a href="/studio"      class="footer-nav-link group block overflow-hidden" style="height:1em; font-size: clamp(1.6rem, 3.2vw, 3rem); font-weight:700; line-height:1; letter-spacing:-0.05em;">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-[50%]">
                <span class="block">Studio</span><span class="block">Studio</span>
              </div>
            </a>
            <a href="/proses"    class="footer-nav-link group block overflow-hidden" style="height:1em; font-size: clamp(1.6rem, 3.2vw, 3rem); font-weight:700; line-height:1; letter-spacing:-0.05em;">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-[50%]">
                <span class="block">Proses</span><span class="block">Proses</span>
              </div>
            </a>
            <a href="/#testimonial" class="footer-nav-link group block overflow-hidden" style="height:1em; font-size: clamp(1.6rem, 3.2vw, 3rem); font-weight:700; line-height:1; letter-spacing:-0.05em;">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-[50%]">
                <span class="block">Klien</span><span class="block">Klien</span>
              </div>
            </a>

            <a href="#"            class="ngobrol-trigger footer-nav-link group block overflow-hidden" style="height:1em; font-size: clamp(1.6rem, 3.2vw, 3rem); font-weight:700; line-height:1; letter-spacing:-0.05em;">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-[50%]">
                <span class="block">Hubungi Kami</span><span class="block">Hubungi Kami</span>
              </div>
            </a>
          </nav>
        </div>

        <!-- RIGHT: Acknowledgement + Info + Sosmed -->
        <div class="w-full md:w-[32%] flex flex-col px-6 md:px-10 pt-8 md:pt-10 pb-10 gap-8">
          <!-- Tentang Kami -->
          <div class="flex flex-col gap-2">
            <p class="text-[14px] font-bold tracking-wide uppercase text-black mb-6">(TENTANG KAMI)</p>
            <p class="text-[0.8rem] leading-[1.55] text-black/60 max-w-xs">
              Kami percaya bahwa setiap ruang memiliki potensi untuk menjadi karya terbaik. Rumah Disain hadir untuk membantu Anda mewujudkan hunian impian dengan pendekatan yang penuh perhatian, kolaboratif, dan berpusat pada visi Anda.
            </p>
          </div>

          <!-- Info Kontak -->
          <div class="flex flex-col gap-1.5">
            <p class="text-[14px] font-bold tracking-wide uppercase text-black mb-6">(INFO)</p>
            <p class="text-[0.8rem] text-black/70">A: Jl. Sudirman No. 88, Jakarta Selatan, 12190</p>
            <a href="mailto:halo@rumahdisain.id" class="text-[0.8rem] text-black hover:opacity-50 transition-opacity">E: halo@rumahdisain.id</a>
            <a href="tel:+62211234567"           class="text-[0.8rem] text-black hover:opacity-50 transition-opacity">P: +62 21 1234 567</a>
            <p class="text-[0.8rem] text-black/50">H: Senin – Jumat, 09.00 – 17.00 WIB</p>
          </div>

          <!-- Sosial Media -->
          <div class="flex flex-col gap-1.5">
            <p class="text-[14px] font-bold tracking-wide uppercase text-black mb-6">(IKUTI KAMI)</p>
            <a href="#" class="group/s relative inline-block overflow-hidden h-[1rem] w-fit">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/s:-translate-y-4">
                <span class="text-[0.8rem] font-semibold h-4 leading-4 uppercase tracking-widest">Instagram</span>
                <span class="text-[0.8rem] font-semibold h-4 leading-4 uppercase tracking-widest">Instagram</span>
              </div>
            </a>
            <a href="#" class="group/s relative inline-block overflow-hidden h-[1rem] w-fit">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/s:-translate-y-4">
                <span class="text-[0.8rem] font-semibold h-4 leading-4 uppercase tracking-widest">Pinterest</span>
                <span class="text-[0.8rem] font-semibold h-4 leading-4 uppercase tracking-widest">Pinterest</span>
              </div>
            </a>
            <a href="#" class="group/s relative inline-block overflow-hidden h-[1rem] w-fit">
              <div class="flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover/s:-translate-y-4">
                <span class="text-[0.8rem] font-semibold h-4 leading-4 uppercase tracking-widest">LinkedIn</span>
                <span class="text-[0.8rem] font-semibold h-4 leading-4 uppercase tracking-widest">LinkedIn</span>
              </div>
            </a>
          </div>
        </div>

      </div>

      <!-- Bottom Bar -->
      <div class="w-full h-[1px] bg-black/10"></div>
      <div class="w-full flex flex-col md:flex-row items-center justify-between px-6 md:px-10 py-4 gap-2">
        <span class="text-[10px] font-bold tracking-widest uppercase text-black/30">© 2024 Rumah Disain. Semua hak dilindungi.</span>
        <span class="text-[10px] font-bold tracking-widest uppercase text-black/30">Dibuat dengan ❤ di Jakarta</span>
      </div>

    </footer>

    <!-- Fullscreen Menu Overlay -->
    <div id="menu-overlay" class="fixed inset-0 z-[999] bg-black text-white flex flex-col justify-between px-8 md:px-12 py-8" style="clip-path: inset(0 0 100% 0);">
      <!-- Top Bar -->
      <div class="flex items-center justify-between">
        <div class="overflow-hidden">
          <img src="/logo-putih.png" alt="Rumah Disain" class="menu-text-reveal inline-block translate-y-[110%] h-10 md:h-14 w-auto" />
        </div>
        <div class="overflow-hidden">
          <div class="menu-text-reveal translate-y-[110%]">
            <button id="menu-close" class="group/close relative block overflow-hidden h-[1em] cursor-pointer hover:opacity-60 transition-opacity">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/close:-translate-y-1/2">
                <span class="text-xs md:text-sm font-bold leading-none tracking-tight uppercase block">CLOSE</span>
                <span class="text-xs md:text-sm font-bold leading-none tracking-tight uppercase block">CLOSE</span>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- Menu Links -->
      <nav class="flex flex-col gap-2 md:gap-3 text-[7vw] md:text-[4vw]">
        <div class="overflow-hidden">
          <div class="menu-text-reveal translate-y-[110%]">
            <a href="/" class="group/menu relative block overflow-hidden h-[0.95em]">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/menu:-translate-y-1/2">
                <span class="block font-semibold leading-[0.95] tracking-[-0.06em] uppercase">BERANDA</span>
                <span class="block font-semibold leading-[0.95] tracking-[-0.06em] uppercase">BERANDA</span>
              </div>
            </a>
          </div>
        </div>
        <div class="overflow-hidden">
          <div class="menu-text-reveal translate-y-[110%]">
