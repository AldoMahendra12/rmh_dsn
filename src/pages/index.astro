---
import { ClientRouter } from "astro:transitions";
import '@fontsource-variable/montserrat';
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Desain Web Mulai Disini</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen m-0 antialiased tracking-tight relative bg-black overflow-x-hidden">
    <!-- Hero Section -->
    <section class="sticky top-0 h-screen w-full overflow-hidden z-0">
      <!-- Backgrounds Animasi -->
    <div class="hero-bg-1 absolute inset-0 w-full h-full bg-amber-950/30 bg-blend-overlay bg-[url('/hero1.png')] bg-cover bg-center bg-no-repeat -z-20 origin-center scale-[1.15]"></div>
    <div class="hero-bg-2 absolute inset-0 w-full h-full bg-amber-950/30 bg-blend-overlay bg-[url('/hero2.png')] bg-cover bg-center bg-no-repeat -z-10" style="clip-path: inset(100% 0 0 0);"></div>

    <!-- Navbar -->
    <nav class="absolute top-0 left-0 w-full flex items-center justify-between px-8 pt-2 pb-4 z-50">
      <div class="overflow-hidden">
        <a href="/" class="logo group flex items-center cursor-pointer h-12 md:h-16 hero-reveal translate-y-[110%]">
          <!-- Logo Icon -->
          <img src="/logo-putih.png" alt="Logo Arsitektur" class="h-12 md:h-16 w-auto relative z-20 drop-shadow-md transition-transform duration-500 ease-out group-hover:scale-105" />
          
          <!-- Efek Logo Kata (Expand & Slide) -->
          <div class="flex items-center overflow-hidden max-w-0 opacity-0 invisible transition-all duration-700 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:max-w-[800px] group-hover:opacity-100 group-hover:visible group-hover:-ml-2">
            <img src="/logo-kata.png" alt="Rumah Disain Text" class="h-16 md:h-[8.5rem] w-auto shrink-0 -translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:-translate-x-2" />
          </div>
        </a>
      </div>

      <!-- Menu Navigasi -->
      <ul class="hidden md:flex items-center gap-3 text-sm font-bold tracking-tight text-white">
        <li>
          <div class="overflow-hidden">
            <a href="/karya" target="_blank" class="group/nav relative block h-5 overflow-hidden text-white hero-reveal translate-y-[110%]">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/nav:-translate-y-5">
                <span class="h-5 leading-5 flex items-center">KARYA</span>
                <span class="h-5 leading-5 flex items-center">KARYA</span>
              </div>
            </a>
          </div>
        </li>
        <li class="text-zinc-400 overflow-hidden"><span class="hero-reveal inline-block translate-y-[110%]">&bull;</span></li>
        <li>
          <div class="overflow-hidden">
            <a href="/studio" class="group/nav relative block h-5 overflow-hidden text-white hero-reveal translate-y-[110%]">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/nav:-translate-y-5">
                <span class="h-5 leading-5 flex items-center">STUDIO</span>
                <span class="h-5 leading-5 flex items-center">STUDIO</span>
              </div>
            </a>
          </div>
        </li>
        <li class="text-zinc-400 overflow-hidden"><span class="hero-reveal inline-block translate-y-[110%]">&bull;</span></li>
        <li>
          <div class="overflow-hidden">
            <a href="/proses" class="group/nav relative block h-5 overflow-hidden text-white hero-reveal translate-y-[110%]">
              <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover/nav:-translate-y-5">
                <span class="h-5 leading-5 flex items-center">PROSES</span>
                <span class="h-5 leading-5 flex items-center">PROSES</span>
              </div>
            </a>
          </div>
        </li>

      </ul>

      <!-- Tombol Hubungi Kami -->
      <div class="overflow-hidden">
        <a href="#" class="ngobrol-trigger group flex items-center gap-4 bg-black text-white px-7 py-3 rounded-full hero-reveal translate-y-[110%] transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] hover:scale-105">
          <div class="relative h-5 overflow-hidden">
            <div class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] transform-gpu group-hover:-translate-y-5">
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase">NGOBROL YUK</span>
              <span class="text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase">NGOBROL YUK</span>
            </div>
          </div>
          <!-- Lingkaran (Agak besar outline di rest state, mengecil dan fill di hover state) -->
          <span class="relative flex items-center justify-center w-3 h-3">
            <span class="absolute w-3 h-3 rounded-full border-[1.5px] border-white transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] transform-gpu group-hover:scale-50 group-hover:bg-white group-hover:border-transparent"></span>
          </span>
        </a>
      </div>
    </nav>

    <!-- Hero Content -->
    <div class="flex items-center justify-center min-h-screen w-full px-8">
      <div class="hero-container w-full">
        <!-- Informasi Proyek (seperti imag1) -->
        <div class="flex flex-col md:flex-row items-center justify-between w-full text-white text-xs md:text-sm font-bold tracking-tight uppercase gap-8 md:gap-0">
          <div class="md:w-1/4 flex justify-center md:justify-start overflow-hidden">
            <span class="hero-reveal translate-y-[110%] inline-block">PROYEK PILIHAN</span>
          </div>
          <div class="md:w-1/4 flex justify-center overflow-hidden">
            <div class="hero-reveal translate-y-[110%]">
              <div class="relative h-5 overflow-hidden">
                <div class="project-name-slider flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)]">
                  <span class="h-5 leading-5 flex items-center">RUMAH JALAN SUDIRMAN</span>
                  <span class="h-5 leading-5 flex items-center">RUMAH KETANON</span>
                </div>
              </div>
            </div>
          </div>
          <div class="md:w-1/4 flex justify-center text-center overflow-hidden">
            <span class="hero-reveal translate-y-[110%] inline-block">2024</span>
          </div>
          <div class="md:w-1/4 flex justify-center md:justify-end overflow-hidden">
            <a href="#" class="group flex items-center gap-3 project-link hero-reveal translate-y-[110%]">
              <div class="relative flex flex-col pb-0.5">
                <div class="relative h-5 overflow-hidden text-white">
                  <div class="flex flex-col transition-transform duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:-translate-y-5">
                    <span class="text-xs md:text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase">LIHAT PROYEK</span>
                    <span class="text-xs md:text-sm font-bold h-5 leading-5 flex items-center tracking-tight uppercase">LIHAT PROYEK</span>
                  </div>
                </div>
                <!-- Animasi Garis Bawah: Menghilang dari kiri ke kanan semakin cepat dan looping 2 kali -->
                <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-white line-loop-element"></span>
              </div>
              <!-- Lingkaran animasi sama seperti tombol utama -->
              <span class="relative flex items-center justify-center w-2.5 h-2.5">
                <span class="absolute w-2.5 h-2.5 rounded-full border-[1.5px] border-white transition-all duration-200 ease-[cubic-bezier(0.65,0,0.35,1)] group-hover:scale-50 group-hover:bg-white group-hover:border-transparent"></span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Teks Bawah Hero (Scroll Down) -->
    <div class="absolute bottom-4 md:bottom-6 left-8 right-8 flex items-end justify-between z-10 bottom-text-container">
      <div class="max-w-[45rem] text-white overflow-hidden">
        <p class="text-lg md:text-3xl font-medium leading-tight drop-shadow-md text-left text-balance hero-reveal translate-y-[110%]" style="word-spacing: 0em; letter-spacing: -0.08em;">
          Gaya Rumah Disain memadukan bentuk kuat dan solid dengan keanggunan halus, keseimbangan alami, serta daya tarik abadi.
        </p>
      </div>
      <div class="overflow-hidden shrink-0 ml-8">
        <div class="text-white text-xs font-bold tracking-tight uppercase mb-1 md:mb-2 hero-reveal translate-y-[110%]">
          (GULIR KE BAWAH)
        </div>
      </div>
    </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="relative z-10 w-full bg-white text-black min-h-screen flex flex-col justify-start pb-20">
      

      <!-- New About Content -->
      <div class="w-full flex flex-col md:flex-row justify-between gap-12 md:gap-0 px-4 md:px-8 pt-8 md:pt-12">
        <!-- Left Column -->
        <div class="w-full md:w-[25%] lg:w-[22%] flex flex-col">
          
          <!-- Top Bar with Progress (Now at Top) -->
          <div class="flex flex-col mb-8">
            <!-- Progress Line -->
            <div class="w-full h-[1px] bg-black/20 mb-4 relative overflow-hidden">
              <div id="au-progress-bar" class="absolute top-0 left-0 h-full bg-black w-0"></div>
            </div>
            <!-- Arrows and Counter -->
            <div class="flex items-center justify-between">
              <div class="flex gap-4">
                <span class="cursor-pointer hover:opacity-70" id="au-prev">&larr;</span>
                <span class="cursor-pointer hover:opacity-70" id="au-next">&rarr;</span>
              </div>
              <span class="text-xs text-black/50 font-mono tracking-widest" id="au-counter">01/03</span>
            </div>
          </div>

          <!-- Image Slider -->
          <div class="relative w-full aspect-video mb-12 overflow-hidden rounded-lg bg-black/5">
            <img class="au-slide-img absolute inset-0 w-full h-full object-cover z-10" style="clip-path: inset(0 0 0 0);" src="/au-1.png" />
            <img class="au-slide-img absolute inset-0 w-full h-full object-cover z-0" style="clip-path: inset(100% 0 0 0);" src="/au-2.png" />
            <img class="au-slide-img absolute inset-0 w-full h-full object-cover z-0" style="clip-path: inset(100% 0 0 0);" src="/au-3.png" />
          </div>
          
          <!-- Text Slider -->
          <div class="relative w-full h-[150px]">
            <!-- Slide 1 Text -->
            <div class="au-slide-text absolute inset-0 flex flex-col z-10 pointer-events-auto">
              <div class="overflow-hidden">
                <h3 class="au-text-reveal text-5xl md:text-6xl font-semibold mb-4 tracking-tight translate-y-0">100+</h3>
              </div>
              <div class="overflow-hidden">
                <p class="au-text-reveal text-sm md:text-base text-black/60 max-w-[250px] leading-snug translate-y-0">Proyek hunian dan komersial yang berhasil kami wujudkan di seluruh Indonesia.</p>
              </div>
            </div>
            <!-- Slide 2 Text -->
            <div class="au-slide-text absolute inset-0 flex flex-col z-0 pointer-events-none">
              <div class="overflow-hidden">
                <h3 class="au-text-reveal text-5xl md:text-6xl font-semibold mb-4 tracking-tight translate-y-[110%]">30+</h3>
              </div>
              <div class="overflow-hidden">
                <p class="au-text-reveal text-sm md:text-base text-black/60 max-w-[250px] leading-snug translate-y-[110%]">Penghargaan berskala global dan apresiasi dari berbagai media arsitektur ternama.</p>
              </div>
            </div>
            <!-- Slide 3 Text -->
            <div class="au-slide-text absolute inset-0 flex flex-col z-0 pointer-events-none">
              <div class="overflow-hidden">
                <h3 class="au-text-reveal text-5xl md:text-6xl font-semibold mb-4 tracking-tight translate-y-[110%]">15+</h3>
              </div>
              <div class="overflow-hidden">
                <p class="au-text-reveal text-sm md:text-base text-black/60 max-w-[250px] leading-snug translate-y-[110%]">Tahun pengalaman berdedikasi menciptakan arsitektur yang berpusat pada manusia.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="w-full md:w-[60%] lg:w-[55%] flex flex-col justify-start text-highlight-container text-highlight">
          <p class="text-[1.35rem] md:text-[1.75rem] lg:text-[2rem] leading-[1.15] font-semibold tracking-tighter mb-12 inline-block">
            Rumah Disain lahir dari keyakinan bahwa setiap ruang harus mampu bercerita tentang siapa penghuninya. Berbekal pengalaman belasan tahun merancang arsitektur, kami tidak sekadar mendesain bangunan, melainkan merangkai pengalaman hidup yang bermakna di setiap sudut hunian.
          </p>
          <p class="text-[1.35rem] md:text-[1.75rem] lg:text-[2rem] leading-[1.15] font-semibold tracking-tighter inline-block">
            Pendekatan kami selalu berpusat pada personalisasi yang mendalam, menerjemahkan impian Anda menjadi ruang yang fungsional, memukau, dan tak lekang oleh waktu.
          </p>
        </div>
      </div>
    </section>

    <!-- Works Section -->
    <section id="works" class="relative z-10 w-full bg-white text-black flex flex-col justify-center h-screen overflow-hidden py-20">
      
      <!-- Top Title Label -->
      <div class="absolute top-10 left-8 md:left-12 z-20">
        <p class="text-[14px] font-bold tracking-wide uppercase text-black">(RUANG YANG KAMI WUJUDKAN)</p>
      </div>

      <!-- Center Wrapper for List -->
      <div class="w-fit flex flex-col items-start justify-center gap-2.5 md:gap-3.5 z-20 relative mx-auto px-4">
        
        <div class="works-list-item cursor-pointer group" data-index="0">
          <h2 class="text-[5.5vw] md:text-[3.8vw] font-bold leading-[0.9] tracking-[-0.08em] text-zinc-400 transition-colors duration-500 hover:text-black select-none">
            Rumah Sudirman
          </h2>
        </div>

        <div class="works-list-item cursor-pointer group" data-index="1">
          <h2 class="text-[5.5vw] md:text-[3.8vw] font-bold leading-[0.9] tracking-[-0.08em] text-zinc-400 transition-colors duration-500 hover:text-black select-none">
            Villa Tropis Bedugul
          </h2>
        </div>

        <div class="works-list-item cursor-pointer group" data-index="2">
          <h2 class="text-[5.5vw] md:text-[3.8vw] font-bold leading-[0.9] tracking-[-0.08em] text-zinc-400 transition-colors duration-500 hover:text-black select-none">
            Klinik Estetika Jakarta
          </h2>
        </div>

        <div class="works-list-item cursor-pointer group" data-index="3">
          <h2 class="text-[5.5vw] md:text-[3.8vw] font-bold leading-[0.9] tracking-[-0.08em] text-zinc-400 transition-colors duration-500 hover:text-black select-none">
            Kantor Ruang Kreatif
          </h2>
        </div>

        <div class="works-list-item cursor-pointer group" data-index="4">
          <h2 class="text-[5.5vw] md:text-[3.8vw] font-bold leading-[0.9] tracking-[-0.08em] text-zinc-400 transition-colors duration-500 hover:text-black select-none">
            Rumah Kaca Sentul
          </h2>
        </div>

        <div class="works-list-item cursor-pointer group" data-index="5">
          <h2 class="text-[5.5vw] md:text-[3.8vw] font-bold leading-[0.9] tracking-[-0.08em] text-zinc-400 transition-colors duration-500 hover:text-black select-none">
            Paviliun Kayu Dago
          </h2>
        </div>

      </div>

      <!-- CTA Button (Centered on Screen) -->
      <div class="mt-14 md:mt-24 w-full flex justify-center z-20 relative">
        <a href="/karya" target="_blank" class="group inline-flex items-center gap-4 bg-black text-white px-8 py-3.5 rounded-full hover:scale-105 transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]">
          <div class="relative h-5 overflow-hidden">
            <div class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:-translate-y-5">
              <span class="text-xs md:text-sm font-bold h-5 leading-5 flex items-center tracking-widest uppercase">LIHAT SEMUA PROYEK</span>
              <span class="text-xs md:text-sm font-bold h-5 leading-5 flex items-center tracking-widest uppercase">LIHAT SEMUA PROYEK</span>
            </div>
          </div>
          <span class="relative flex items-center justify-center w-2.5 h-2.5">
            <span class="absolute w-2.5 h-2.5 rounded-full border-[1.5px] border-white transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:scale-50 group-hover:bg-white group-hover:border-transparent"></span>
          </span>
        </a>
      </div>

      <!-- Absolute Images Container (Rendered off-screen or clipped out) -->
      <div class="absolute inset-0 pointer-events-none z-10 w-full h-full overflow-hidden">
        
        <!-- Image 0 -->
        <div class="works-image-container absolute left-[6%] md:left-[10vw] top-[20%] w-[28vw] md:w-[15vw] aspect-[3/4] overflow-hidden" style="opacity: 0; transform: translateY(20px);">
          <img src="/hero1.png" alt="Rumah Sudirman" class="w-full h-full object-cover" />
        </div>

        <!-- Image 1 -->
        <div class="works-image-container absolute right-[6%] md:right-[10vw] top-[25%] w-[28vw] md:w-[15vw] aspect-[3/4] overflow-hidden" style="opacity: 0; transform: translateY(20px);">
          <img src="/au-1.png" alt="Villa Tropis Bedugul" class="w-full h-full object-cover" />
        </div>

        <!-- Image 2 -->
        <div class="works-image-container absolute left-[12vw] top-[24%] w-[28vw] md:w-[15vw] aspect-[3/4] overflow-hidden" style="opacity: 0; transform: translateY(20px);">
          <img src="/hero2.png" alt="Klinik Estetika Jakarta" class="w-full h-full object-cover" />
        </div>

        <!-- Image 3 -->
        <div class="works-image-container absolute right-[8vw] top-[18%] w-[28vw] md:w-[15vw] aspect-[3/4] overflow-hidden" style="opacity: 0; transform: translateY(20px);">
          <img src="/au-2.png" alt="Kantor Ruang Kreatif" class="w-full h-full object-cover" />
        </div>

        <!-- Image 4 -->
        <div class="works-image-container absolute left-[8vw] top-[26%] w-[28vw] md:w-[15vw] aspect-[3/4] overflow-hidden" style="opacity: 0; transform: translateY(20px);">
          <img src="/au-3.png" alt="Rumah Kaca Sentul" class="w-full h-full object-cover" />
        </div>

        <!-- Image 5 -->
        <div class="works-image-container absolute right-[11vw] top-[22%] w-[28vw] md:w-[15vw] aspect-[3/4] overflow-hidden" style="opacity: 0; transform: translateY(20px);">
          <img src="/hero1.png" alt="Paviliun Kayu Dago" class="w-full h-full object-cover" />
        </div>

      </div>
    </section>

    <script>
      // Works Section GSAP Animation
      const workItems = document.querySelectorAll(".works-list-item");
      const workImages = document.querySelectorAll(".works-image-container");

      workItems.forEach((item, index) => {
        item.addEventListener("mouseenter", () => {
          gsap.to(workImages[index], { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" });
        });
        item.addEventListener("mouseleave", () => {
          gsap.to(workImages[index], { opacity: 0, y: 20, duration: 0.5, ease: "power2.out" });
        });
      });
    </script>

    <!-- Process Section -->
    <section id="process" class="relative z-10 w-full bg-white text-black">

      <!-- Main 2-column layout — unified, no independent scrolling -->
      <div class="w-full flex flex-col md:flex-row min-h-screen">

        <!-- LEFT COLUMN — normal flow, narrow -->
        <div class="w-full md:w-[28%] flex flex-col px-6 md:px-8 py-10 md:py-12">

          <!-- Label -->
          <p class="text-[14px] font-bold tracking-wide uppercase text-black mb-6">(CARA KAMI BERKARYA)</p>

          <!-- Photo -->
          <div class="w-full max-w-[320px] aspect-square overflow-hidden mb-8 shrink-0">
            <img src="/hero1.png" alt="Proses Rumah Disain" class="w-full h-full object-cover" />
          </div>

          <!-- Stage List -->
          <div class="flex flex-col w-full">
            <div class="flex items-center gap-4 py-2 border-t border-black/10">
              <span class="text-[15px] md:text-[17px] font-medium text-black/50 shrink-0">(01)</span>
              <span class="text-[15px] md:text-[17px] font-semibold tracking-tight text-black leading-tight">Konsep Desain</span>
            </div>
            <div class="flex items-center gap-4 py-2 border-t border-black/10">
              <span class="text-[15px] md:text-[17px] font-medium text-black/50 shrink-0">(02)</span>
              <span class="text-[15px] md:text-[17px] font-semibold tracking-tight text-black leading-tight">Pengembangan Desain</span>
            </div>
            <div class="flex items-center gap-4 py-2 border-t border-black/10">
              <span class="text-[15px] md:text-[17px] font-medium text-black/50 shrink-0">(03)</span>
              <span class="text-[15px] md:text-[17px] font-semibold tracking-tight text-black leading-tight">Pengurusan Izin</span>
            </div>
            <div class="flex items-center gap-4 py-2 border-t border-black/10">
              <span class="text-[15px] md:text-[17px] font-medium text-black/50 shrink-0">(04)</span>
              <span class="text-[15px] md:text-[17px] font-semibold tracking-tight text-black leading-tight">Desain Interior</span>
            </div>
            <div class="flex items-center gap-4 py-2 border-t border-black/10">
              <span class="text-[15px] md:text-[17px] font-medium text-black/50 shrink-0">(05)</span>
              <span class="text-[15px] md:text-[17px] font-semibold tracking-tight text-black leading-tight">Gambar & Dokumen Izin</span>
            </div>
            <div class="flex items-center gap-4 py-2 border-t border-b border-black/10">
              <span class="text-[15px] md:text-[17px] font-medium text-black/50 shrink-0">(06)</span>
              <span class="text-[15px] md:text-[17px] font-semibold tracking-tight text-black leading-tight">Gambar Kerja & Detail</span>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN — normal flow, wide, vertically centered content -->
        <div class="w-full md:w-[72%] flex flex-col justify-center px-6 md:px-16 lg:px-24 py-10 md:py-16 gap-8 md:gap-12">

          <!-- Descriptions -->
          <div class="max-w-3xl flex flex-col gap-6 md:gap-8">
            <p class="text-[1.6rem] md:text-[2.2rem] lg:text-[2.8rem] font-bold leading-[1.05] tracking-[-0.03em] text-black">
              Pendekatan kami dirancang untuk memastikan perjalanan Anda dari konsep awal hingga selesai berjalan semudah, sejelas, dan seindah mungkin, tanpa kejutan, tanpa kebingungan.
            </p>
            <p class="text-[1.6rem] md:text-[2.2rem] lg:text-[2.8rem] font-bold leading-[1.05] tracking-[-0.03em] text-black">
              Melalui 6 tahapan proses yang terstruktur, kami mengutamakan kejelasan, kolaborasi aktif, dan komitmen penuh untuk mewujudkan visi unik Anda di setiap langkahnya.
            </p>
          </div>

