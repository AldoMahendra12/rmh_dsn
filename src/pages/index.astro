    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";


      // Animasi muncul perlahan menggunakan GSAP
      document.addEventListener('astro:page-load', () => {
        // Kill existing triggers to prevent duplicates during client-side navigation
        ScrollTrigger.getAll().forEach(t => t.kill());

        gsap.registerPlugin(ScrollTrigger);

        // Process Cards Stack Animation
        const processCards = gsap.utils.toArray('.process-card');
        processCards.forEach((card, i) => {
          if (i === processCards.length - 1) return; // Don't scale the last card
          
          gsap.to(card, {
            scale: 0.95 - (processCards.length - 1 - i) * 0.015,
            transformOrigin: "top center",
            ease: "power1.inOut",
            scrollTrigger: {
              trigger: processCards[i + 1],
              start: "top 15%", 
              end: "top top", 
              scrub: true,
            }
          });
        });

        // About Us Slider Logic
        const auSlideImgs = document.querySelectorAll('.au-slide-img');
        const auSlideTexts = document.querySelectorAll('.au-slide-text');
        const auProgressBar = document.getElementById('au-progress-bar');
        const auCounter = document.getElementById('au-counter');
        const auNext = document.getElementById('au-next');
        const auPrev = document.getElementById('au-prev');
        
        if (auSlideImgs.length > 0 && auProgressBar && auCounter) {
          let currentAuSlide = 0;
          let auProgressAnim;
          let isAnimating = false;

          const goToAuSlide = (index) => {
            if (isAnimating) return;
            isAnimating = true;
            
            if (auProgressAnim) auProgressAnim.kill();
            
            const oldIndex = currentAuSlide;
            currentAuSlide = (index + auSlideImgs.length) % auSlideImgs.length;
            
            if (oldIndex === currentAuSlide) {
              isAnimating = false;
              return;
            }
            
            const oldImg = auSlideImgs[oldIndex];
            const newImg = auSlideImgs[currentAuSlide];
            
            const oldTextContainer = auSlideTexts[oldIndex];
            const newTextContainer = auSlideTexts[currentAuSlide];
            
            const oldTexts = oldTextContainer.querySelectorAll('.au-text-reveal');
            const newTexts = newTextContainer.querySelectorAll('.au-text-reveal');
            
            // Setup new elements
            gsap.set(newImg, { clipPath: 'inset(100% 0 0 0)', zIndex: 10 });
            gsap.set(oldImg, { zIndex: 1 });
            
            oldTextContainer.classList.add('pointer-events-none');
            oldTextContainer.classList.remove('pointer-events-auto');
            newTextContainer.classList.add('pointer-events-auto');
            newTextContainer.classList.remove('pointer-events-none');
            
            gsap.set(newTextContainer, { zIndex: 10 });
            gsap.set(oldTextContainer, { zIndex: 1 });
            gsap.set(newTexts, { y: '110%' });
            
            const tl = gsap.timeline({ onComplete: () => {
              isAnimating = false;
              resetAuProgress();
            }});
            
            // Animate out old text
            tl.to(oldTexts, { y: '-110%', duration: 0.5, ease: 'power3.inOut', stagger: 0.05 }, 0);
            
            // Animate in new image (clip from bottom)
            tl.to(newImg, { clipPath: 'inset(0% 0 0 0)', duration: 0.8, ease: 'power3.inOut' }, 0);
            
            // Animate in new text (clip from bottom)
            tl.to(newTexts, { y: '0%', duration: 0.8, ease: 'power3.out', stagger: 0.05 }, 0.2);
            
            auCounter.textContent = `0${currentAuSlide + 1}/0${auSlideImgs.length}`;
          };

          const resetAuProgress = () => {
            if (auProgressAnim) auProgressAnim.kill();
            gsap.set(auProgressBar, { width: '0%' });
            auProgressAnim = gsap.to(auProgressBar, {
              width: '100%',
              duration: 1.5,
              ease: 'none',
              onComplete: () => goToAuSlide(currentAuSlide + 1)
            });
          };

          auNext?.addEventListener('click', () => goToAuSlide(currentAuSlide + 1));
          auPrev?.addEventListener('click', () => goToAuSlide(currentAuSlide - 1));

          resetAuProgress(); // start auto-slide
        }

        // About Buttons Reveal Animation
        const aboutBtnReveals = document.querySelectorAll('.about-btn-reveal');
        if (aboutBtnReveals.length > 0) {
          gsap.to(aboutBtnReveals, {
            scrollTrigger: {
              trigger: '#about',
              start: 'top 60%',
              toggleActions: 'play none none reverse',
            },
            opacity: 1,
            y: 0,
            stagger: 0.08,
            duration: 0.6,
            ease: 'power2.out',
          });
        }

        // Text Highlight Reveal
        const textHighlights = document.querySelectorAll('.text-highlight');
        if (textHighlights.length > 0) {
          gsap.to(textHighlights, {
            backgroundPosition: "0% 0%",
            ease: "none",
            scrollTrigger: {
              trigger: '.text-highlight-container',
              start: 'top 75%',
              end: 'bottom 40%',
              scrub: 1,
            }
          });
        }



        // Sticky Floating Buttons (forever)
        const stickyButtonsWrapper = document.querySelector('#sticky-buttons-wrapper');
        if (stickyButtonsWrapper) {
          ScrollTrigger.create({
            trigger: stickyButtonsWrapper,
            start: "top top",
            end: "max",
            pin: true,
            pinSpacing: false,
          });
        }

        // Hero Reveal Animation - Clip from bottom to top
        const heroReveals = document.querySelectorAll('.hero-reveal');
        if (heroReveals.length > 0) {
          gsap.to(heroReveals, {
            y: '0%',
            duration: 1.2,
            ease: 'power4.out',
            stagger: 0.08,
            delay: 0.3,
          });
        }

        // Animasi Hover LIHAT PROYEK
        const projectLink = document.querySelector('.project-link');
        if (projectLink) {
          const hoverTl = gsap.timeline({ paused: true });
          
          hoverTl.to('.hero-bg-1', {
            scale: 1,
            duration: 0.8,
            ease: "power3.inOut"
          })
          .to('.hero-bg-2', {
            clipPath: "inset(0% 0% 0% 0%)",
            duration: 0.8,
            ease: "power3.inOut"
          }, "-=0.6");

          const projectNameSlider = document.querySelector('.project-name-slider');

          projectLink.addEventListener('mouseenter', () => {
            hoverTl.play();
            if (projectNameSlider) projectNameSlider.classList.add('-translate-y-5');
          });
          
          projectLink.addEventListener('mouseleave', () => {
            hoverTl.reverse();
            if (projectNameSlider) projectNameSlider.classList.remove('-translate-y-5');
          });
        }

        // Fullscreen Menu Overlay
        const menuTrigger = document.querySelector('#menu-trigger');
        const menuClose = document.querySelector('#menu-close');
        const menuOverlay = document.querySelector('#menu-overlay');
        const menuTextReveals = document.querySelectorAll('.menu-text-reveal');

        if (menuTrigger && menuOverlay && menuClose) {
          let menuOpen = false;
          const menuTl = gsap.timeline({ paused: true });

          // Step 1: Clip overlay from top
          menuTl.to(menuOverlay, {
            clipPath: 'inset(0 0 0% 0)',
            duration: 0.8,
            ease: 'power4.inOut',
          });

          // Step 2: Reveal text lines from bottom
          menuTl.to(menuTextReveals, {
            y: '0%',
            duration: 0.6,
            ease: 'power4.out',
            stagger: 0.04,
          }, '-=0.3');

          menuTrigger.addEventListener('click', (e) => {
            e.preventDefault();
            if (!menuOpen) {
              menuOpen = true;
              document.body.style.overflow = 'hidden';
              menuTl.play();
            }
          });

          const closeMenu = () => {
            menuOpen = false;
            document.body.style.overflow = '';
            // Reverse text first, then overlay
            gsap.to(menuTextReveals, {
              y: '110%',
              duration: 0.4,
              ease: 'power3.in',
              stagger: 0.02,
              onComplete: () => {
                gsap.to(menuOverlay, {
                  clipPath: 'inset(0 0 100% 0)',
                  duration: 0.6,
                  ease: 'power4.inOut',
                  onComplete: () => {
                    menuTl.pause(0);
                  }
                });
              }
            });
          };

          menuClose.addEventListener('click', closeMenu);

          // Close menu overlay when clicking any link
          const menuLinks = menuOverlay.querySelectorAll('nav a');
          menuLinks.forEach(link => {
            link.addEventListener('click', closeMenu);
          });
        }

        // Works List Hover and Animation
        const worksListItems = document.querySelectorAll('.works-list-item');
        const worksImageContainers = document.querySelectorAll('.works-image-container');
        const worksSection = document.querySelector('#works');

        if (worksListItems.length > 0 && worksImageContainers.length > 0) {
          // Entry animation when section scrolls into view
          gsap.from(worksListItems, {
            scrollTrigger: {
              trigger: worksSection,
              start: "top 60%",
            },
            y: 50,
            opacity: 0,
            duration: 1,
            stagger: 0.1,
            ease: "power4.out"
          });

          worksListItems.forEach((item, index) => {
            const correspondingImg = worksImageContainers[index];

            item.addEventListener('mouseenter', () => {
              // Dim other list items
              worksListItems.forEach((otherItem, otherIndex) => {
                if (otherIndex !== index) {
                  gsap.to(otherItem.querySelector('h2'), {
                    opacity: 0.15,
                    duration: 0.4,
                    ease: "power2.out"
                  });
                } else {
                  gsap.to(otherItem.querySelector('h2'), {
                    scale: 1.02,
                    duration: 0.4,
                    ease: "power2.out"
                  });
                }
              });

              // Randomize placement
              const side = index % 2 === 0 ? 'left' : 'right';
              const randomTop = 10 + Math.random() * 25; // 10% to 35%
              const randomOffset = 4 + Math.random() * 12; // 4vw to 16vw

              gsap.killTweensOf(correspondingImg);
              
              // Apply randomized layout offsets before revealing
              gsap.set(correspondingImg, {
                left: 'auto',
                right: 'auto',
                top: `${randomTop}%`,
                [side]: `${randomOffset}vw`
              });

              // Reveal image
              gsap.to(correspondingImg, {
                opacity: 1,
                y: 0,
                rotation: 0,
                duration: 0.6,
                ease: "power2.out"
              });
            });

            item.addEventListener('mouseleave', () => {
              // Restore all list items
              worksListItems.forEach((otherItem) => {
                gsap.to(otherItem.querySelector('h2'), {
                  opacity: 1,
                  scale: 1,
                  duration: 0.4,
                  ease: "power2.out"
                });
              });

              // Hide image
              gsap.killTweensOf(correspondingImg);
              gsap.to(correspondingImg, {
                opacity: 0,
                y: 20,
                rotation: 0,
                duration: 0.5,
                ease: "power2.inOut"
              });
            });
          });
        }

        // Contact Drawer Logic
        const contactPanel = document.getElementById('contact-panel');
        const contactBackdrop = document.getElementById('contact-backdrop');
        const contactTriggers = document.querySelectorAll('.ngobrol-trigger');
        const contactCloseBtns = document.querySelectorAll('.contact-close');
        const contactNextBtn = document.getElementById('contact-next');
        const contactBackBtn = document.getElementById('contact-back');
        const contactNext2Btn = document.getElementById('contact-next-2');
        const contactBack3Btn = document.getElementById('contact-back-3');
        const contactSubmitBtn = document.getElementById('contact-submit');
        const contactDoneBtn = document.getElementById('contact-done');

        const step1 = document.getElementById('contact-step-1');
        const step2 = document.getElementById('contact-step-2');
        const step3 = document.getElementById('contact-step-3');
        const successScreen = document.getElementById('contact-success');

        let isContactOpen = false;

        const openContact = (e) => {
          if (e) e.preventDefault();
          isContactOpen = true;
          document.body.style.overflow = 'hidden';

          // Reset steps
          if (step1 && step2 && step3 && successScreen) {
            step1.classList.remove('hidden');
            step2.classList.add('hidden');
            step3.classList.add('hidden');
            successScreen.classList.add('hidden');
          }

          // Reset input values
          const nameInput = document.getElementById('contact-name');
          const emailInput = document.getElementById('contact-email');
          const phoneInput = document.getElementById('contact-phone');
          const otherDetailsInput = document.getElementById('contact-other-details');
          if (nameInput) nameInput.value = '';
          if (emailInput) emailInput.value = '';
          if (phoneInput) phoneInput.value = '';
          if (otherDetailsInput) otherDetailsInput.value = '';

          // Reset project type buttons to default (NEW HOME active, others inactive)
          const typeBtns = document.querySelectorAll('.project-type-btn');
          typeBtns.forEach(btn => {
            if (btn.getAttribute('data-value') === 'new-home') {
              btn.classList.add('bg-white', 'text-black');
              btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            } else {
              btn.classList.remove('bg-white', 'text-black');
              btn.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            }
          });

          // Reset hear about buttons to default (INSTAGRAM active, others inactive)
          const hearBtns = document.querySelectorAll('.hear-about-btn');
          hearBtns.forEach(btn => {
            if (btn.getAttribute('data-value') === 'instagram') {
              btn.classList.add('bg-white', 'text-black');
              btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            } else {
              btn.classList.remove('bg-white', 'text-black');
              btn.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            }
          });

          // Reveal backdrop
          if (contactBackdrop) {
            contactBackdrop.classList.remove('hidden');
            gsap.to(contactBackdrop, { opacity: 1, duration: 0.5 });
          }

          // Reveal side panel (clipPath from right)
          if (contactPanel) {
            gsap.to(contactPanel, {
              clipPath: 'inset(0 0 0 0%)',
              duration: 0.8,
              ease: 'power4.inOut'
            });
          }
        };

        const closeContact = () => {
          isContactOpen = false;
          document.body.style.overflow = '';

          // Hide backdrop
          if (contactBackdrop) {
            gsap.to(contactBackdrop, {
              opacity: 0,
              duration: 0.5,
              onComplete: () => {
                contactBackdrop.classList.add('hidden');
              }
            });
          }

          // Hide side panel
          if (contactPanel) {
            gsap.to(contactPanel, {
              clipPath: 'inset(0 0 0 100%)',
              duration: 0.6,
              ease: 'power4.inOut'
            });
          }
        };

        contactTriggers.forEach(btn => btn.addEventListener('click', openContact));
        contactCloseBtns.forEach(btn => btn.addEventListener('click', closeContact));
        contactBackdrop?.addEventListener('click', closeContact);

        // Toggle project type selection (multiple select enabled)
        const projectTypeBtns = document.querySelectorAll('.project-type-btn');
        projectTypeBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            if (btn.classList.contains('bg-white')) {
              // De-select
              btn.classList.remove('bg-white', 'text-black');
              btn.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            } else {
              // Select
              btn.classList.add('bg-white', 'text-black');
              btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            }
          });
        });

        // Toggle hear about selection (single select)
        const hearAboutBtns = document.querySelectorAll('.hear-about-btn');
        hearAboutBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            hearAboutBtns.forEach(b => {
              b.classList.remove('bg-white', 'text-black');
              b.classList.add('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
            });
            btn.classList.add('bg-white', 'text-black');
            btn.classList.remove('bg-zinc-900', 'text-white', 'hover:bg-zinc-800');
          });
        });

        contactNextBtn?.addEventListener('click', () => {
          // Validate required fields
          const nameInput = document.getElementById('contact-name');
          const emailInput = document.getElementById('contact-email');
          if (nameInput && emailInput) {
            if (!nameInput.value.trim() || !emailInput.value.trim()) {
              alert('Harap isi Nama dan Alamat Email Anda.');
              return;
            }
          }
          if (step1 && step2) {
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
          }
        });

        contactBackBtn?.addEventListener('click', () => {
          if (step1 && step2) {
            step2.classList.add('hidden');
            step1.classList.remove('hidden');
          }
        });

        contactNext2Btn?.addEventListener('click', () => {
          const selectedBtns = document.querySelectorAll('.project-type-btn.bg-white');
          if (selectedBtns.length === 0) {
            alert('Harap pilih minimal satu jenis proyek.');
            return;
          }
          if (step2 && step3) {
            step2.classList.add('hidden');
            step3.classList.remove('hidden');
          }
        });

        contactBack3Btn?.addEventListener('click', () => {
          if (step2 && step3) {
            step3.classList.add('hidden');
            step2.classList.remove('hidden');
          }
        });

        contactSubmitBtn?.addEventListener('click', () => {
          const selectedBtns = document.querySelectorAll('.hear-about-btn.bg-white');
          if (selectedBtns.length === 0) {
            alert('Harap pilih salah satu opsi bagaimana Anda mengetahui tentang kami.');
            return;
          }
          const otherBtn = document.querySelector('.hear-about-btn[data-value="other"]');
          if (otherBtn && otherBtn.classList.contains('bg-white')) {
            const otherDetails = document.getElementById('contact-other-details');
            if (otherDetails && !otherDetails.value.trim()) {
              alert('Harap isi detail bagaimana Anda mengetahui tentang kami.');
              return;
            }
          }
          if (step3 && successScreen) {
            step3.classList.add('hidden');
            successScreen.classList.remove('hidden');
          }
        });

        contactDoneBtn?.addEventListener('click', closeContact);

        // Refresh triggers on next frame to ensure correct height and layout calculations
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
        });
      });
    </script>

